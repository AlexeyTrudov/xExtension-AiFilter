<div class="aif-logbox">
	<input type="radio" name="aif-logfilter" id="aif-f-all" checked="checked" />
	<label for="aif-f-all">All</label>
	<input type="radio" name="aif-logfilter" id="aif-f-kept" />
	<label for="aif-f-kept">Kept</label>
	<input type="radio" name="aif-logfilter" id="aif-f-skip" />
	<label for="aif-f-skip">Removed</label>
	<input type="radio" name="aif-logfilter" id="aif-f-sys" />
	<label for="aif-f-sys">System</label>

	<div class="aif-log">
	<?php foreach ($this->logTail(300) as $line): ?>
		<?php
			if (trim($line) === '') {
				continue;
			}
			preg_match('/^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}) (\w+)\s+(.*)$/u', $line, $m);
			$ts = $m[1] ?? '';
			$type = $m[2] ?? 'INFO';
			$rest = $m[3] ?? $line;
		?>
		<div class="aif-line aif-<?= $e($type) ?>"><span class="aif-ts"><?= $e($ts) ?></span> <span class="aif-type"><?= $e($type) ?></span> <?= $e($rest) ?></div>
	<?php endforeach; ?>
	</div>
</div>
